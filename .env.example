# SAGE LLM backend configuration (optional; numerical path requires no API calls)
# Copy to .env and fill in only if using the claude/openai LLM backends.
# Never commit real secrets to this file.

# Heavy-path LLM backend selection: mock | claude | openai
SAGE_LLM_BACKEND=mock

# OpenAI-compatible backend
SAGE_LLM_MODEL=
SAGE_LLM_BASE_URL=
SAGE_LLM_API_KEY=

# Anthropic Claude backend
SAGE_CLAUDE_MODEL=
