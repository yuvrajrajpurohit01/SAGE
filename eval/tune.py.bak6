"""Validation-only threshold selection; test data never enters selection."""
from dataclasses import asdict, replace
import json
from pathlib import Path
import numpy as np
import torch
from sage.config import Config
from sage.data.datasets import PreparedData
from sage.pipeline import SAGEPipeline
from sage.verify.decision import decide


def tune(pipeline: SAGEPipeline, data: PreparedData, checkpoint: dict, output: str | Path,
         tau1_values: list[float], tau2_values: list[float], limit: int | None = None) -> dict:
    indices = data.indices("validation")
    if limit is not None:
        if limit < 1:
            raise ValueError("Limit must be positive")
        indices = indices[:limit]
    if not len(indices) or not tau1_values or not tau2_values:
        raise ValueError("Nonempty validation and candidate grids required")
    rows = []
    with torch.inference_mode():
        for i in indices:
            s = pipeline.small(torch.from_numpy(data.x[i:i+1]))
            qs = pipeline.gate(s.features).confidence.item()
            h = pipeline.heavy(data.inputs(int(i), checkpoint["narrative"]))
            ql = pipeline.reflection(pipeline.encoder(h)).item()
            rows.append((s.prediction[0].tolist(), h.y_l, qs, ql))
    scores = []
    for tau1 in tau1_values:
        for tau2 in tau2_values:
            config = replace(pipeline.config, tau1=tau1, tau2=tau2)
            pred = [s if qs >= tau1 else decide(s, h, qs, ql, config).prediction for s, h, qs, ql in rows]
            rmse = float(np.sqrt(np.mean((np.asarray(pred)-data.y[indices])**2)))
            routed = sum(qs < tau1 for _, _, qs, _ in rows)
            scores.append({"tau1": tau1, "tau2": tau2, "validation_rmse": rmse, "heavy_count": routed})
    best = min(scores, key=lambda r: (r["validation_rmse"], r["heavy_count"]))
    checkpoint = dict(checkpoint)
    checkpoint["config"] = asdict(replace(pipeline.config, tau1=best["tau1"], tau2=best["tau2"]))
    checkpoint["threshold_selection"] = {"split": "validation", "sample_ids": [data.ids[i] for i in indices], "best": best}
    output = Path(output)
    output.mkdir(parents=True, exist_ok=True)
    torch.save(checkpoint, output/"sage-tuned.pt")
    report = {"best": best, "grid": scores, "samples": len(indices), "note": "Validation-tuned thresholds, not CoLLM paper preset C."}
    (output/"threshold_selection.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
    return report
